# =========================================================
# quickslogx HRMS - Environment Variables Configuration
# =========================================================

# 1. MongoDB Atlas Cloud Database (Primary Storage for Tasks, Chat, Attendance, Users)
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/quickslogx_hrms?retryWrites=true&w=majority
# MONGODB_DB=quickslogx_hrms

# 2. Google Drive 5TB File & Media Storage
# GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here
# GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REFRESH_TOKEN=your_refresh_token

# 3. Supabase Realtime & Redundancy (Optional)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
